rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidUserProfile(data, userId) {
      return data.uid is string && data.uid == userId &&
             data.email is string && data.email.size() <= 128 &&
             data.tier in ['free', 'pro'] &&
             data.isPro is bool;
    }

    function isValidUserProgress(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.totalAnswered is number && data.totalAnswered >= 0 &&
             data.totalCorrect is number && data.totalCorrect >= 0;
    }

    // Test connection document for verifying connectivity
    match /test/{docId} {
      allow read: if docId == 'connection' || isSignedIn();
    }

    // User profile documents
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId) && isOwner(userId) && isValidUserProfile(incoming(), userId);
      allow update: if isValidId(userId) && isOwner(userId) && isValidUserProfile(incoming(), userId);
      allow delete: if isValidId(userId) && isOwner(userId);

      // User progress subcollection
      match /progress/{docId} {
        allow get, list: if isValidId(userId) && isOwner(userId);
        allow create: if isValidId(userId) && isOwner(userId) && isValidUserProgress(incoming(), userId);
        allow update: if isValidId(userId) && isOwner(userId) && isValidUserProgress(incoming(), userId);
        allow delete: if isValidId(userId) && isOwner(userId);
      }
    }
  }
}
